.git/
.gitignore
/*.md
docs/
.pi/
.dsh/

# One .dockerignore serves both image builds — pi (./Containerfile) and dsh
# (./Containerfile.dsh) both build from the repo-root context. seed/ is
# generally NOT needed in either build context: pi's config home (~/.pi) and
# dsh's $DSH_HOME (seed/.dsh) are bind-mounted live at runtime, never
# COPY'd into the image. EXCEPTION: the pi Containerfile COPYs
# seed/.pi/agent/skills.json at BUILD time to drive the build-time skill
# clone, so that one file must be let back through the ignore.

seed/*
!seed/.pi/

seed/.pi/*
!seed/.pi/agent/

seed/.pi/agent/*
!seed/.pi/agent/skills.json
