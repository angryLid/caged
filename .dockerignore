.git/
.gitignore
/*.md
docs/
.pi/
.dsh/

# One .dockerignore serves both image builds — pi (./Containerfile) and dsh
# (./Containerfile.dsh) both build from the repo-root context. seed/ is
# generally NOT needed in either build context: the agent homes (.pi, .dsh,
# .commandcode) are bind-mounted live at runtime, never COPY'd into the
# image. EXCEPTION: the shared base Containerfile COPYs seed/skills.json at
# BUILD time to drive the build-time skill clone, so that one file must be
# let back through the ignore (it is the only seed file the base image
# carries; everything else in seed/ is live host state).

seed/*
!seed/skills.json
