.git/
.gitignore
/*.md
docs/
.pi/
.dsh/

# One .dockerignore serves every image build (pi, dsh, webui, cmdc) — they all
# build from the repo-root context. seed/ is never needed in a build context:
# the agent homes (.pi, .dsh, .commandcode), the skill sources and both sync
# configs are bind-mounted live at runtime, never COPY'd into an image. The
# git skill repos are cloned into seed/skills-sync/vendor/ on the HOST
# (scripts/build-caged-base.sh), so they stay out of the image too.

seed/
