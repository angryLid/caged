# Node / npm runtime state that pi may drop into the working tree
node_modules/
.pnpm-store/

# OS cruft
.DS_Store

# Shell / editor leftovers
*.swp
.idea/
.vscode/

# pi session data (written via the sessionDir setting to /workspace/.pi/sessions,
# i.e. $CAGED_WORKSPACE/.pi/sessions on the host)
.pi/sessions/

# pi-web-ui chat data (per-project: /workspace/.pi-web on the host — when a
# web-mode container runs against this repo as its workspace)
.pi-web/

# dsh session data (mounted from $WORKSPACE/.dsh/sessions)
.dsh/sessions/

# Command Code project taste profile and runtime state
# (in a workspace repo, /workspace/.commandcode holds the session catalog and
# /rewind file backups relocated from the seed by commandcode-entrypoint.sh)
/.commandcode/
# seed/.commandcode is Command Code's HOME-level state dir in the seed; its
# tracked config is settings.json (bypass mode), everything else is runtime
# state. The generated skills/ dir is covered by the skills-sync rules above.
seed/.commandcode/*
!seed/.commandcode/settings.json

# Runtime state pi writes back into the live $HOME bind mount
seed/.pi/agent/auth.json
seed/.pi/agent/sessions/
seed/.pi/agent/mcp-onboarding.json
seed/.pi/agent/mcp-cache.json
# web-search tool response cache (written during container runs)
seed/.pi/agent/web-search-cache/
# pi's regenerable model catalog cache (from `pi update --models`)
seed/.pi/agent/models-store.json
# pi's mission index and run history (agent runtime state, regenerated)
seed/.pi/agent/missions/
seed/.pi/agent/run-history.jsonl
# gh runtime state written into the live seed
seed/.local/
# MCP server runtime caches written into the live seed HOME
seed/.cache/
# CLI configs written to their default location (XDG_CONFIG_HOME = $HOME/.config
# in this container, i.e. seed/.config): glab/gh/jira-cli and friends following
# their own defaults drop non-secret config here. It is NOT managed by caged —
# tokens stay in the env (GITLAB_TOKEN/GH_TOKEN/JIRA_API_TOKEN) and never land
# here (see docs/CLI-AUTH.md).
seed/.config/
# Legacy acli configs left over from a pre-migration run (token-bearing,
# never committed). acli is no longer installed; remove this dir once the
# table is clear and delete these files (see docs/CLI-AUTH.md).
seed/cli-auth/

# skills-sync: clones of the external skill repos, refreshed by
# scripts/build-caged-base.sh (and by running skills-sync.mjs by hand). They
# live in the seed so every container reaches them through the seed mount;
# they are third-party checkouts, so they stay out of this repo's history.
seed/skills-sync/vendor/
# skills-sync: generated skill copies in each agent's seed skills dir
# (installed at container start). Sources of truth live in seed/skills-src/
# (git-tracked); the skills/ dirs are regenerated artifacts and ignored.
seed/.pi/agent/skills/
seed/.dsh/skills/
seed/.commandcode/skills/

# prompt-sync: the generated global-prompt targets + their managed markers.
# Sources of truth live in seed/prompt-src/ (git-tracked); the per-agent
# copies are regenerated at container start from seed/prompts.json and are
# ignored, exactly like the skills/ dirs above.
seed/.pi/agent/AGENTS.md
seed/.pi/agent/.caged-prompt-managed.*
seed/.commandcode/.caged-prompt-managed.*

# dsh ($DSH_HOME in the seed) — runtime state generated by dsh; the enforcing
# rule is the nested seed/.dsh/.gitignore (it tracks only cordis.patch.yml,
# .gitkeep, .gitignore). These entries mirror it at the repo level, next to
# the seed/.pi rules above.
seed/.dsh/profiles/
seed/.dsh/settings.yaml
seed/.dsh/.credentials.yaml
seed/.dsh/.env
seed/.dsh/.anonymous-user-id
seed/.dsh/sessions/
seed/.dsh/storages/
