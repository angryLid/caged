# Node / npm runtime state that pi may drop into the working tree
node_modules/
.pnpm-store/

# OS cruft
.DS_Store

# Shell / editor leftovers
*.swp
.idea/
.vscode/

# pi session data (written via the sessionDir setting to /workspace/.pi/sessions,
# i.e. $CAGED_WORKSPACE/.pi/sessions on the host)
.pi/sessions/

# pi-web-ui chat data (per-project: /workspace/.pi-web on the host — when a
# web-mode container runs against this repo as its workspace)
.pi-web/

# dsh session data (mounted from $WORKSPACE/.dsh/sessions)
.dsh/sessions/

# Command Code project taste profile and runtime state
.commandcode/
seed/.commandcode/

# Runtime state pi writes back into the live $HOME bind mount
seed/.pi/agent/auth.json
seed/.pi/agent/sessions/
seed/.pi/agent/mcp-onboarding.json
seed/.pi/agent/mcp-cache.json
# web-search tool response cache (written during container runs)
seed/.pi/agent/web-search-cache/
# pi's regenerable model catalog cache (from `pi update --models`)
seed/.pi/agent/models-store.json
# Shared CLI authentication state. `acli jira auth login`, `glab auth` and
# `gh auth` login persist credentials here for all agent modes, but these
# files must never be committed (see docs/CLI-AUTH.md).
seed/cli-auth/glab/*
seed/cli-auth/acli/*
seed/cli-auth/gh/*
!seed/cli-auth/glab/.gitkeep
!seed/cli-auth/acli/.gitkeep
!seed/cli-auth/gh/.gitkeep

# skills-sync: local-dev clones of external skill repos (only used when running
# skills-sync.mjs by hand; at container start the repos come from the image-
# baked /opt/caged/skills/vendor, not from here)
seed/.pi/agent/skills-sync/vendor/
# skills-sync: generated skill copies in the seed's skills dir (installed at
# container start). Sources of truth live in seed/.pi/agent/skills-src/ (git-
# tracked); the skills/ dir is a regenerated artifact and ignored wholesale.
seed/.pi/agent/skills/

# dsh ($DSH_HOME in the seed) — runtime state generated by dsh; the enforcing
# rule is the nested seed/.dsh/.gitignore (it tracks only cordis.patch.yml,
# .gitkeep, .gitignore). These entries mirror it at the repo level, next to
# the seed/.pi rules above.
seed/.dsh/profiles/
seed/.dsh/settings.yaml
seed/.dsh/.credentials.yaml
seed/.dsh/.env
seed/.dsh/.anonymous-user-id
seed/.dsh/sessions/
seed/.dsh/storages/
seed/.commandcode/
