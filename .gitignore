# Node / npm runtime state that pi may drop into the working tree
node_modules/
.pnpm-store/

# OS cruft
.DS_Store

# Shell / editor leftovers
*.swp
.idea/
.vscode/

# pi session data (mounted from $CAGED_WORKSPACE/sessions)
sessions/

# Runtime state pi writes back into the live $HOME bind mount
seed/.pi/agent/auth.json
seed/.pi/agent/sessions/
seed/.pi/agent/mcp-cache.json
# pi's regenerable model catalog cache (from `pi update --models`)
seed/.pi/agent/models-store.json
# acli (Atlassian CLI) credentials: `acli jira auth login` stores its token
# here via ACLI_CONFIG_DIR — persisted across restarts but never committed
seed/.pi/agent/acli/

# skills-sync: clones of external skill repos live INSIDE the seed (regenerated
# by scripts/skills-sync.mjs at container start into -/.pi/agent/skills-sync/vendor)
seed/.pi/agent/skills-sync/vendor/
# skills-sync: generated skill symlinks in the seed's skills dir (regenerated at
# container start). Hand-written/committed skills below are un-ignored.
seed/.pi/agent/skills/*
!seed/.pi/agent/skills/bgm-metadata/
!seed/.pi/agent/skills/caged-persistence/
!seed/.pi/agent/skills/create-post/
!seed/.pi/agent/skills/markdown-link/
!seed/.pi/agent/skills/mdx-notes/
!seed/.pi/agent/skills/skills-sync/
