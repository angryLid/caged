# syntax=docker/dockerfile:1

# caged-base — shared base image for the caged (pi) and dsh images.
# Contains common runtime essentials, pinned CLIs, the non-root agent user, and persistent directories.

FROM debian:bookworm-slim

# Runtime and native-build packages: git (version control), ca-certificates (TLS), curl (HTTP), python3 and pip (scripting/dependencies/node-gyp), jq (JSON), tini (PID 1), and build-essential (native npm modules).
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl gnupg python3 python3-pip jq tini build-essential && rm -rf /var/lib/apt/lists/*

# Install Node.js 24 LTS from NodeSource (replaces the node:24-slim image's bundled toolchain).
ARG NODE_MAJOR=24
RUN set -eux; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# Keep the conventional `python` and `pip` commands available in all shells and scripts.
RUN ln -s /usr/bin/python3 /usr/local/bin/python \
    && ln -s /usr/bin/pip3 /usr/local/bin/pip

# Install uv globally so the non-root agent can manage Python environments and dependencies.
RUN python3 -m pip install --no-cache-dir --break-system-packages uv \
    && pip --version \
    && uv --version

# Install the pinned Node.js package managers globally via npm.
ARG PNPM_VERSION=10.15.0
ARG YARN_VERSION=1.22.22
RUN npm install -g "pnpm@${PNPM_VERSION}" "yarn@${YARN_VERSION}" \
    && pnpm --version \
    && yarn --version

# glab — official GitLab CLI, pinned and sha256-verified.
ARG GLAB_VERSION=1.112.0
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) sha=f1c52907558b665f2032b615787d353cd06e54240b501a81f9489bfc8f6a8ebf;; \
      arm64) sha=54a5fe7de0db23e34151c55e561c28e59e6ef6a7731f7d0ce8a00fa58cd8d8f8;; \
      *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1;; \
    esac; \
    curl -fsSL -o /tmp/glab.tar.gz \
      "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${GLAB_VERSION}/glab_${GLAB_VERSION}_linux_${TARGETARCH}.tar.gz"; \
    echo "${sha}  /tmp/glab.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/glab \
    && tar -xzf /tmp/glab.tar.gz -C /tmp/glab \
    && install -m 0755 /tmp/glab/bin/glab /usr/local/bin/glab \
    && rm -rf /tmp/glab /tmp/glab.tar.gz \
    && glab version

# gh — official GitHub CLI (https://github.com/cli/cli).
# Single static Go binary: pinned version + sha256 verified against the
# official per-release gh_<ver>_checksums.txt. TARGETARCH comes from BuildKit
# and both amd64/arm64 linux assets exist, so the same Dockerfile builds for
# either.
ARG GH_VERSION=2.97.0
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) sha=a2c9b8497e1f85b1ad0dfcb78b5a622e098801b8e461e459e88e1ee12f018112;; \
      arm64) sha=73ea440ecad9c9e284429997ee6f93577bc6f7bc6fba357ef62c53ad8fb641a5;; \
      *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1;; \
    esac; \
    curl -fsSL -o /tmp/gh.tar.gz \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${TARGETARCH}.tar.gz"; \
    echo "${sha}  /tmp/gh.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/gh \
    && tar -xzf /tmp/gh.tar.gz -C /tmp/gh \
    && install -m 0755 /tmp/gh/gh_${GH_VERSION}_linux_${TARGETARCH}/bin/gh /usr/local/bin/gh \
    && rm -rf /tmp/gh /tmp/gh.tar.gz \
    && gh version

# jira-cli — community Jira CLI (github.com/ankitpokhrel/jira-cli), pinned to a
# versioned release tarball + checksum. Shipped as the `jira` binary. MIT.
# Auth is env-token driven (`JIRA_API_TOKEN`), so — unlike the Atlassian acli it
# replaces — no token is ever persisted to disk inside the container.
ARG JIRA_VERSION=1.7.0
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) arch=x86_64; sha=b5e0ba4804f3f11f92c483d9a6ea9ebccec1c735cd2e12b0440cab9d7afd626a;; \
      arm64) arch=arm64; sha=80aa3cc02790892b29e1580a8e49eb49a6550815b362c5ef8c05aea1dee73a95;; \
      *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1;; \
    esac; \
    curl -fsSL -o /tmp/jira.tar.gz \
      "https://github.com/ankitpokhrel/jira-cli/releases/download/v${JIRA_VERSION}/jira_${JIRA_VERSION}_linux_${arch}.tar.gz"; \
    echo "${sha}  /tmp/jira.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/jira \
    && tar -xzf /tmp/jira.tar.gz -C /tmp/jira \
    && install -m 0755 "/tmp/jira/jira_${JIRA_VERSION}_linux_${arch}/bin/jira" /usr/local/bin/jira \
    && rm -rf /tmp/jira /tmp/jira.tar.gz \
    && jira version

# cfl — Confluence Cloud CLI (github.com/open-cli-collective/atlassian-cli),
# pinned to a versioned release tarball + checksum. Shipped as the `cfl`
# binary. MIT. Targets Confluence Cloud (v2 REST API); not for Server/DC.
# Auth is env-token driven (CFL_URL / CFL_EMAIL / CFL_API_TOKEN — the same
# Atlassian API token as JIRA_API_TOKEN): env vars resolve before the OS
# keyring, so in this keyring-less container no token is ever persisted to
# disk and `cfl set-credential` is never used.
ARG CFL_VERSION=1.3.96
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) sha=e4bbbb79009bdf3a368b72cfece52bcacf65df68736a39c88dabe95c381455e1;; \
      arm64) sha=27e702c1c2326e328171f420a28a6a1897af860d97c9654a8eed0bf78f62552d;; \
      *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1;; \
    esac; \
    curl -fsSL -o /tmp/cfl.tar.gz \
      "https://github.com/open-cli-collective/atlassian-cli/releases/download/cfl-v${CFL_VERSION}/cfl_${CFL_VERSION}_linux_${TARGETARCH}.tar.gz"; \
    echo "${sha}  /tmp/cfl.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/cfl \
    && tar -xzf /tmp/cfl.tar.gz -C /tmp/cfl \
    && install -m 0755 /tmp/cfl/cfl /usr/local/bin/cfl \
    && rm -rf /tmp/cfl /tmp/cfl.tar.gz \
    && cfl --version

# Create the shared non-root agent user (no `node` user to remove in a plain Debian base).
RUN useradd --create-home --home-dir /agent-home --uid 1000 --shell /bin/bash agent \
    && mkdir -p /workspace /agent-home \
    && chown -R agent:agent /workspace /agent-home

# Declarative skills and global prompt — only the sync SCRIPTS are baked in;
# no skill content and no third-party git history lives in the image.
#
# The git skill source repos are cloned on the HOST into the seed
# (seed/skills-sync/vendor/skills) by scripts/build-caged-base.sh, and the
# whole seed is bind-mounted at /agent-home in every container — so each
# image's entrypoint runs the same --link-only install reading the repos
# straight off that mount (still no network and no git at container start).
# The prompt source (prompt-src/global.md) and both configs (skills.json,
# prompts.json) come from the same live mount.
COPY scripts/skills-sync.mjs scripts/prompt-sync.mjs /opt/caged/

# Persistent home and mounted workspace paths used by both derived images.
ENV HOME=/agent-home WORKSPACE=/workspace

# USER, WORKDIR, ENTRYPOINT, and CMD are defined by the derived images.
