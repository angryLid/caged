# syntax=docker/dockerfile:1

# caged — hardened container for Command Code.
# Command Code requires Node.js 22 or newer; the shared base uses Node 24.
# Authentication and Command Code state stay in the live seed mount at
# /agent-home/.commandcode, while project files remain in /workspace.
# Skills: the base image bakes only skills-sync.mjs; the git skill repos live
# in the seed (seed/skills-sync/vendor, cloned on the host at build time), and
# the entrypoint installs the enabled skills into
# /agent-home/.commandcode/skills at every start.

ARG CAGED_BASE_IMAGE=caged-base:latest

FROM ${CAGED_BASE_IMAGE}

ARG COMMAND_CODE_VERSION=latest
RUN npm install -g command-code@${COMMAND_CODE_VERSION} && cmd --version

RUN mkdir -p /agent-home/.commandcode /agent-home/.config \
    && chown -R agent:agent /agent-home

COPY scripts/commandcode-entrypoint.sh /usr/local/bin/commandcode-entrypoint
RUN chmod +x /usr/local/bin/commandcode-entrypoint

USER agent
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/commandcode-entrypoint"]
CMD ["cmd"]
