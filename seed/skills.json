{
  "sources": [
    {
      "name": "gitlab-ai-skills",
      "type": "git",
      "url": "https://gitlab.com/gitlab-org/ai/skills.git",
      "skillsDir": "skills",
      "enabled": [
        "commit-messages",
        "glab",
        "glab-glql"
      ]
    },
    {
      "name": "mattpocock-skills",
      "type": "git",
      "url": "https://github.com/mattpocock/skills.git",
      "skillsDir": "skills",
      "enabled": [
        "productivity/grill-me",
        "productivity/grilling",
        "productivity/handoff",
        "productivity/teach",
        "productivity/to-questionnaire",
        "productivity/wait-what",
        "productivity/writing-for-agents"
      ]
    },
    {
      "name": "local",
      "type": "local",
      "dir": "skills-src",
      "enabled": [
        "caged-persistence",
        "atlassian",
        "markdown-link",
        "skills-sync"
      ]
    }
  ],
  "linkTargets": [
    {
      "name": "pi",
      "dir": ".pi/agent/skills"
    },
    {
      "name": "dsh",
      "dir": ".dsh/skills"
    },
    {
      "name": "cmdc",
      "dir": ".commandcode/skills"
    }
  ]
}
